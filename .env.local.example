# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 git 에 올라가지 않습니다)

# Neon Postgres 연결 문자열 (Vercel Marketplace > Neon 에서 발급)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# 관리자 로그인 비밀번호 (원하는 값으로 설정)
ADMIN_PASSWORD="change-me-please"

# 이미지 업로드용 Vercel Blob 토큰
# Vercel 에 Blob 스토어를 연결하면 자동 주입됩니다. 로컬에서 업로드를 테스트하려면
# Vercel > Storage > Blob > .env.local 탭의 토큰을 복사해 넣으세요.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
